# Required. Give both devices a DHCP reservation so these addresses do not change.
PS5_HOST=192.168.1.20
TV_HOST=192.168.1.30

# Optional, defaults shown.
#TV_PORT=5555
#POLL_INTERVAL=5s
# Consecutive standby replies needed before acting.
#STANDBY_CONFIRM=2
# Log what would happen, but do not send the sleep key.
#DRY_RUN=false

# Telegram notifications and buttons. Set both, or leave both empty to disable.
# The chat id must be a number.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
# Messages when the PS5 turns on, enters rest mode or goes offline.
#TELEGRAM_NOTIFY_PS5=true
# Messages when the TV turns on or off.
#TELEGRAM_NOTIFY_TV=true
# Show the button that turns off the TV. The status button is always available.
#TELEGRAM_TV_BUTTON=true

# Regex for the TV's foreground app. If set, the TV is powered off only when it
# matches, so a movie in Netflix keeps playing. Find your value in the
# "tv foreground app" log line while the TV shows the PS5's HDMI input. For
# example, com.mitv.livetv on a Xiaomi Mi TV.
#TV_REQUIRE_FOCUS=
